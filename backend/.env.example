# Server
PORT=5000
FLASK_DEBUG=true
FRONTEND_URL=http://127.0.0.1:5500
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_HOURS=24

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=task_manager

# Keep false locally. Set true for Aiven and provide its CA certificate path on Render.
DB_SSL_ENABLED=false
DB_SSL_CA=
